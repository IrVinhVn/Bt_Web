        "func": "// Thuật toán tạo dữ liệu danh sách sinh viên với số tiền ngẫu nhiên\nlet danhSachTen = [\"Cốp\", \"David\", \"Vinh\", \"Hải\"];\nlet dssv = [];\n\nfor (let i = 0; i < danhSachTen.length; i++) {\n    dssv.push({\n        \"name\": danhSachTen[i],\n        \"money\": Math.floor(Math.random() * 1000) + 100 // Random từ 100 đến 1099\n    });\n}\n\n// Đóng gói thành định dạng JSON đúng yêu cầu đề bài\nmsg.payload = {\n    \"ok\": 1,\n    \"msg\": \"thành công\",\n    \"dssv\": dssv\n};\n\nreturn msg;",
